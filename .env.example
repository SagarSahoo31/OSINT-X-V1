# ==============================================================================
# OSINT-X Environment Configuration
# ==============================================================================

# Core App Settings
APP_NAME=OSINT-X
APP_ENV=production
APP_SECRET_KEY=change_this_to_a_secure_32_character_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Port Mappings (Change these if you have local port conflicts)
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OLLAMA_PORT=11434

# PostgreSQL Database Settings
POSTGRES_DB=osintx
POSTGRES_USER=osintx_user
POSTGRES_PASSWORD=osintx_secure_password

# Neo4j Graph Database Settings
NEO4J_USER=neo4j
NEO4J_PASSWORD=osintx_neo4j_password

# Defensive Security Controls
ALLOW_PRIVATE_IP_SCANNING=False
MAX_COLLECTOR_TIMEOUT_SECONDS=180
MAX_BUFFER_OUTPUT_BYTES=52428800
